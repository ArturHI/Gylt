# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Never commit real values.

# The address of your school's Canvas, with no trailing slash.
CANVAS_BASE_URL=https://canvas.example.edu

# A personal access token from Canvas: Account > Settings > New Access Token.
CANVAS_TOKEN=your-canvas-access-token

# Google Calendar. The README walks through creating these two values
# in the Google Cloud console.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Leave this one alone. `npm run google:auth` fills it in for you.
GOOGLE_REFRESH_TOKEN=

# Weather. Optional: with these left out, the forecast is for Norman, OK.
# Uncomment and change them to use another place in the United States.
# WEATHER_LATITUDE=35.2226
# WEATHER_LONGITUDE=-97.4395

# Supabase (the database for projects and to-dos).
# Both are in the Supabase dashboard under Project Settings > API Keys / Data API.
# Use the SECRET key, not the publishable one. It never leaves the server.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Duolingo. Your username as it appears in your profile link:
# duolingo.com/profile/<username>. Not a secret, and no password is needed.
DUOLINGO_USERNAME=your-duolingo-username
